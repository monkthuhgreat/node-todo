# Этап 1: Сборка и подготовка 
# Используется легковесный образ Node.js на базе Alpine Linux в качестве базового для сборки
FROM node:20-alpine AS builder
# Назначение рабочей директории внутри контейнера для первого этапа
WORKDIR /app
# Копируются файлы манифестов зависимостей package.json и package-lock.json
COPY package*.json ./
# Установка всех зависимостей проекта по package-lock.json без изменения самого файла
# Использование npm ci ускоряет сборку и гарантирует идентичность модулей на всех машинах
RUN npm ci --frozen-lockfile
# Копирование всего исходного кода приложения с локального компьютера в рабочую директорию
COPY . . 

# Этап 2: Чистый запуск 
# Снова используется чистый образ Node.js. Всё, что было на первом этапе (инструменты сборки, кэш npm), отсекается
FROM node:20-alpine
# Назначение рабочей директории для финального приложения
WORKDIR /app

# Копирование готовых папок из первого этапа (builder)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY --from=builder /app/package*.json ./

# Создание системной группы и пользователя nodejs с ID 1001 для безопасности 
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    # Передаем права на чтение и запись в папку /app созданному пользователю nodejs
    chown -R nodejs:nodejs /app
# Документирование порта контейнера
EXPOSE 5000
# Команда для запуска приложения при старте контейнера (используется прямой запуск основного файла)
CMD ["node", "src/server.js"]